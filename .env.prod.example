# ============================================================================
# Production env for the VPS. Copy to `.env.prod`, fill in, keep it SECRET.
# Used both for docker-compose interpolation and as the API/migrate env_file:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# NEVER commit the filled-in .env.prod.
# ============================================================================

# --- Public address -------------------------------------------------------
# The origin browsers hit. With a domain (recommended): https://hub.example.com
# No domain yet: http://YOUR_SERVER_IP   (plain HTTP)
PUBLIC_ORIGIN=https://hub.example.com
# Caddy site address. With a domain: hub.example.com (auto-HTTPS).
# No domain yet: :80    (plain HTTP — must match PUBLIC_ORIGIN scheme/host)
SITE_ADDRESS=hub.example.com

# --- Database (internal to the tricon-net Docker network) ------------------
POSTGRES_USER=tricon
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=tricon_it_hub
# Host is the compose service name `postgres`. Keep password in sync with above.
DATABASE_URL=postgresql://tricon:CHANGE_ME_strong_db_password@postgres:5432/tricon_it_hub

# --- Queue / cache (internal) ---------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth (MUST be real in production) ------------------------------------
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_long_random_secret
JWT_EXPIRES_IN=12h
# Login is ENFORCED in production. Do not set this true on a public server.
AUTH_DISABLED=false
NEXT_PUBLIC_AUTH_DISABLED=false

# --- Seed admin (created on first db:seed; change immediately after) -------
SEED_ADMIN_EMAIL=you@tricon.example
SEED_ADMIN_PASSWORD=CHANGE_ME_temp_admin_password
SEED_ADMIN_NAME=Admin

# --- LLM providers (server-side only) -------------------------------------
LLM_PROVIDER=anthropic
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_DIM=1536
PII_PSEUDONYMIZE=true

# --- CORS: lock to your public origin in production -----------------------
CORS_ORIGIN=https://hub.example.com

# --- Phase 2 sources (keep sandbox until real creds are wired) -------------
SOURCES_SANDBOX=true

# --- SLA sweep job ---------------------------------------------------------
SLA_JOBS=true
SLA_SWEEP_MS=900000
