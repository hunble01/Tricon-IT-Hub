// TRICON IT HUB — Prisma schema (Phase 1, Step 2)
//
// Required Postgres extensions: vector (pgvector), pg_trgm.
// These are managed via the postgresqlExtensions preview feature; the first
// migration emits CREATE EXTENSION statements automatically.
//
// MemoryEntry.embedding is typed as Unsupported("vector(1536)") so Prisma
// creates the column at the right type. Queries against it go through
// $queryRaw (e.g. ORDER BY embedding <=> $query LIMIT k). EMBEDDING_DIM is
// pinned at 1536 in DDL because pgvector requires a literal at column-create
// time; the EMBEDDING_DIM env var is the *provider-side* contract (the
// LlmProvider validates returned vectors match this dim before insert).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

// ────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  AGENT
}

enum BuildingStatus {
  LIVE
  OPENING
  COMING_SOON
  CORPORATE
}

enum RoleCategory {
  BUILDING_STAFF
  MANAGER
  CORPORATE
}

enum DeviceType {
  LAPTOP
  SURFACE
  PHONE
  TABLET
  HEADSET
  DOCK
  MONITOR
  MINI_PC
  USB_ADAPTER
  OTHER
  // Updates §6a — peripherals tracked per-item (MONITOR/DOCK/HEADSET already above).
  KEYBOARD
  MOUSE
  WEBCAM
  CABLE
  ADAPTER
}

enum DeviceStatus {
  IN_STOCK
  ASSIGNED
  RETURNED
  IN_REPAIR
  RETIRED
  // Updates §6a — messy reality captured by site audits.
  MISSING
  MISPLACED
  OFFSITE
}

enum DocType {
  QUOTE
  RECEIPT
  INVOICE
}

enum InvoiceStatus {
  UPLOADED
  EXTRACTED
  REVIEWED
  PROCESSED
}

enum EmploymentStatus {
  ONBOARDING
  ACTIVE
  NO_SHOW
  DEPARTED
}

enum StaffSource {
  ONBOARDING
  TICKET
  MANUAL
}

enum OnboardingDeviceStatus {
  PENDING
  ALREADY_SET_UP
  DONE
}

// Phase 2 — offboarding lifecycle (mirror of onboarding).
enum OffboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TicketSource {
  MANUAL
  ZENDESK
  SERVICENOW
  OUTLOOK
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MemoryType {
  TICKET_RESOLUTION
  KB
  STAFF_CONTEXT
  ACTION_LOG
  NOTE
}

// Tasks — non-ticket operational work (todo board).
enum TaskType {
  INSTALL
  ASSIGN_DEVICE
  RETURN_DEVICE
  REPAIR
  SETUP
  ACCESS
  PROCUREMENT
  AUDIT
  ONBOARDING
  OFFBOARDING
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskSource {
  MANUAL
  ONBOARDING
  OFFBOARDING
  TICKET
  INTAKE
  ASSISTANT
}

// ────────────────────────────────────────────────────────────
// Models
// ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(AGENT)
  createdAt    DateTime @default(now())

  assignments     DeviceAssignment[]
  auditLogs       AuditLog[]
  assignedTickets Ticket[]           @relation("TicketAssignee")
  ticketReplies   TicketReply[]
}

model Building {
  id           String         @id @default(cuid())
  name         String         @unique
  displayName  String?
  neighborhood String?
  status       BuildingStatus @default(LIVE)
  notes        String?

  staff       Staff[]
  devices     Device[]
  onboardings Onboarding[]
}

model Role {
  id             String       @id @default(cuid())
  title          String       @unique
  category       RoleCategory @default(BUILDING_STAFF)
  isSharedDevice Boolean      @default(false)
  notes          String?

  deviceProfile RoleDeviceProfile[]
  staff         Staff[]
}

model RoleDeviceProfile {
  id         String     @id @default(cuid())
  roleId     String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  deviceType DeviceType
  quantity   Int        @default(1)

  @@unique([roleId, deviceType])
}

model Staff {
  id               String           @id @default(cuid())
  fullName         String
  firstName        String
  lastName         String
  adPrefix         String?
  roleId           String?
  role             Role?            @relation(fields: [roleId], references: [id])
  buildingId       String?
  building         Building?        @relation(fields: [buildingId], references: [id])
  startDate        DateTime?
  employmentStatus EmploymentStatus @default(ONBOARDING)
  email            String?
  phone            String?
  source           StaffSource      @default(MANUAL)
  notes            String?
  createdAt        DateTime         @default(now())

  devices     DeviceAssignment[]
  onboarding  Onboarding?
  offboarding Offboarding?
  tickets     Ticket[]

  @@index([buildingId])
  @@index([lastName])
  @@index([adPrefix])
}

model Device {
  id           String       @id @default(cuid())
  assetTag     String?      @unique
  serialNumber String?      @unique
  type         DeviceType
  model        String?
  status       DeviceStatus @default(IN_STOCK)
  locationId   String?
  location     Building?    @relation(fields: [locationId], references: [id])
  notes        String?
  createdAt    DateTime     @default(now())

  // Updates §6a — purchase provenance. purchaseLocationId / invoiceLineItemId are
  // plain id refs (resolved in the service layer) to keep the migration additive.
  purchaseCost       Decimal?  @db.Decimal(12, 2)
  purchaseDate       DateTime?
  purchaseLocationId String?
  invoiceLineItemId  String?

  assignments DeviceAssignment[]

  @@index([type, status])
  @@index([locationId])
  @@index([invoiceLineItemId])
}

model DeviceAssignment {
  id           String    @id @default(cuid())
  deviceId     String
  device       Device    @relation(fields: [deviceId], references: [id])
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id])
  assignedById String?
  assignedBy   User?     @relation(fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now())
  returnedAt   DateTime?
  notes        String?

  @@index([deviceId])
  @@index([staffId])
  @@index([returnedAt])
}

model Onboarding {
  id                 String                 @id @default(cuid())
  staffId            String                 @unique
  staff              Staff                  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  stockSourceId      String?
  stockSource        Building?              @relation(fields: [stockSourceId], references: [id])
  startDate          DateTime?
  adDone             Boolean                @default(false)
  badgeDone          Boolean                @default(false)
  hardwareDone       Boolean                @default(false)
  softwareDone       Boolean                @default(false)
  recommendedDevices Json
  deviceStatus       OnboardingDeviceStatus @default(PENDING)
  assignedTech       String?
  monthLabel         String?
  notes              String?
  createdAt          DateTime               @default(now())

  @@index([monthLabel])
  @@index([deviceStatus])
}

// Phase 2 — offboarding: the counterpart to onboarding. Walks a departing
// hire through reclaiming gear (chain-of-custody close-out), disabling AD,
// returning the badge, and revoking software. Mirrors Onboarding's shape so
// the board UI is symmetric. References an EXISTING Staff (never creates one).
model Offboarding {
  id               String            @id @default(cuid())
  staffId          String            @unique
  staff            Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  lastDay          DateTime?
  adDisabled       Boolean           @default(false)
  badgeReturned    Boolean           @default(false)
  hardwareReturned Boolean           @default(false)
  accountsRevoked  Boolean           @default(false)
  status           OffboardingStatus @default(PENDING)
  assignedTech     String?
  monthLabel       String?
  reason           String?
  notes            String?
  createdAt        DateTime          @default(now())

  @@index([monthLabel])
  @@index([status])
}

model Ticket {
  id               String         @id @default(cuid())
  source           TicketSource   @default(MANUAL)
  externalId       String?
  requesterStaffId String?
  requester        Staff?         @relation(fields: [requesterStaffId], references: [id])
  subject          String
  body             String
  category         String?
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(NORMAL)
  slaDueAt         DateTime?
  lastReplyAt      DateTime?
  raw              Json?
  createdAt        DateTime       @default(now())

  // Phase 2 §5 — delegated, per-agent action model. A ticket is claimed by an
  // agent; reply/send is enabled only on tickets assigned to the acting agent.
  assignedToUserId String?
  assignedTo       User?          @relation("TicketAssignee", fields: [assignedToUserId], references: [id])
  assignedAt       DateTime?

  drafts  TicketDraft[]
  replies TicketReply[]

  @@unique([source, externalId])
  @@index([status, priority])
  @@index([requesterStaffId])
  @@index([assignedToUserId])
  @@index([slaDueAt])
}

// Phase 2 §5 — human-in-the-loop send log. Every Send is a real (or, before
// credentials, sandbox-simulated) push back to the source, stamped as the
// acting agent. Never auto-sent. `mode` records live vs. sandbox; `delivered`
// is true once the external call succeeds (always true in sandbox).
model TicketReply {
  id           String       @id @default(cuid())
  ticketId     String
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  channel      TicketSource
  body         String
  internalNote String?
  mode         String       @default("sandbox")
  delivered    Boolean      @default(false)
  externalRef  String?
  createdAt    DateTime     @default(now())

  @@index([ticketId])
}

model TicketDraft {
  id               String   @id @default(cuid())
  ticketId         String
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  suggestedReply   String
  suggestedNote    String?
  retrievedContext Json?
  model            String?
  createdAt        DateTime @default(now())

  @@index([ticketId])
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  title     String
  content   String
  source    String?
  tags      String[]
  createdAt DateTime @default(now())

  @@index([title])
}

model MemoryEntry {
  id        String                       @id @default(cuid())
  type      MemoryType
  refTable  String?
  refId     String?
  content   String
  // Vector column is created by Prisma at type vector(1536). Queries use $queryRaw.
  embedding Unsupported("vector(1536)")?
  metadata  Json?
  createdAt DateTime                     @default(now())

  @@index([type])
  @@index([refTable, refId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ────────────────────────────────────────────────────────────
// Updates §6c — site audit (reconcile records vs. reality)
// References to Building/User/Device are plain id fields resolved in the
// service layer (keeps this migration additive; no back-relations added).
// ────────────────────────────────────────────────────────────

model SiteAudit {
  id            String           @id @default(cuid())
  buildingId    String
  performedById String?
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  notes         String?

  entries SiteAuditEntry[]

  @@index([buildingId])
}

model SiteAuditEntry {
  id           String        @id @default(cuid())
  siteAuditId  String
  siteAudit    SiteAudit     @relation(fields: [siteAuditId], references: [id], onDelete: Cascade)
  deviceId     String?
  expected     Boolean       @default(true)
  found        Boolean       @default(false)
  resultStatus DeviceStatus?
  notes        String?

  @@index([siteAuditId])
  @@index([deviceId])
}

// ────────────────────────────────────────────────────────────
// Updates §6d — procurement ingestion (CDW quotes/receipts/invoices)
// ────────────────────────────────────────────────────────────

model PurchaseDoc {
  id            String        @id @default(cuid())
  vendor        String        @default("CDW")
  docType       DocType
  docNumber     String?
  purchaseDate  DateTime?
  destinationId String?
  totalCost     Decimal?      @db.Decimal(12, 2)
  filePath      String
  status        InvoiceStatus @default(UPLOADED)
  extractionRaw Json?
  uploadedById  String?
  createdAt     DateTime      @default(now())

  lineItems InvoiceLineItem[]

  @@index([status])
  @@index([destinationId])
}

model InvoiceLineItem {
  id            String      @id @default(cuid())
  purchaseDocId String
  purchaseDoc   PurchaseDoc @relation(fields: [purchaseDocId], references: [id], onDelete: Cascade)
  description   String
  quantity      Int         @default(1)
  unitCost      Decimal?    @db.Decimal(12, 2)
  serialNumbers String[]
  mappedType    DeviceType?
  reviewed      Boolean     @default(false)
  createdDeviceIds String[]

  @@index([purchaseDocId])
}

// ────────────────────────────────────────────────────────────
// Tasks — unified todo board for non-ticket operational work
// (equipment installs, laptop assign/return, setups, access requests…).
// Tasks arrive from many sources (onboarding/offboarding/tickets/intake/the AI
// assistant/manual) via a task-source pattern. Entity refs are plain ids
// resolved in the service layer (matches §6c/§6d) so this migration stays
// additive — just one new table.
// ────────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        TaskType     @default(OTHER)
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NORMAL)
  source      TaskSource   @default(MANUAL)

  // What the task is about (plain id refs, resolved in the service layer).
  staffId    String?
  deviceId   String?
  buildingId String?
  ticketId   String?

  // Ownership (plain id refs to User).
  assigneeId  String?
  createdById String?

  dueDate     DateTime?
  completedAt DateTime?

  // Idempotency key for generated tasks: a source upserts by this key so
  // re-running a generator (e.g. onboarding sync) never duplicates a task.
  sourceKey String? @unique

  // Calendar sync (MS Graph). Set once the task has been pushed to a calendar.
  calendarEventId String?
  calendarSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priority])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([buildingId])
  @@index([staffId])
}
