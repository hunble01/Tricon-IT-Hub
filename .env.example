# --- Database ---
DATABASE_URL=postgresql://tricon:tricon@localhost:5432/tricon_it_hub

# --- Queue / cache ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# --- Seed admin (created on first db:seed) ---
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin

# --- LLM provider (server-side only; never exposed to web) ---
LLM_PROVIDER=openai            # openai | anthropic  (completions)
# Optional: serve embeddings from a different provider than completions.
# Anthropic has no embeddings endpoint, so to get real Claude completions with
# real vectors, set LLM_PROVIDER=anthropic + EMBEDDING_PROVIDER=openai.
# Leave blank to embed with the same provider as completions.
EMBEDDING_PROVIDER=            # openai | anthropic | (blank)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_DIM=1536             # must match the pgvector column dim (vector(1536))
PII_PSEUDONYMIZE=true

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Dev only: set true to bypass login and run every request as the seeded
#     admin. Leave false/unset in any shared or production environment. ---
AUTH_DISABLED=false

# Comma-separated allowlist of browser origins for CORS. Empty/unset = reflect
# any origin (dev). Set to your web domain(s) in prod, e.g. https://hub.tricon.com
CORS_ORIGIN=

# --- Phase 2 live sources (built against DEV SANDBOXES only — never real Tricon data) ---
# Unset = clearly-labelled SANDBOX sample data so the pipeline is demoable. Set to go live.
SOURCES_SANDBOX=true
# ServiceNow Personal Developer Instance (REST Table API, basic auth)
SERVICENOW_INSTANCE_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
# Microsoft Graph — delegated per-agent Mail.Read + Mail.Send. GRAPH_ACCESS_TOKEN is for local testing only.
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
GRAPH_ACCESS_TOKEN=

# --- Phase 2 SLA sweep (BullMQ, uses REDIS_URL above) ---
# Recurring job that re-checks open tickets against their SLA. On by default.
SLA_JOBS=true
# Sweep interval in ms (default 900000 = 15 min).
SLA_SWEEP_MS=900000
